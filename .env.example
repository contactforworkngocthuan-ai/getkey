# Existing GET KEY project's Production Environment Variables
BASE_URL=https://YOUR-GETKEY-PROJECT.vercel.app
LINK4M_API_KEY=SET_YOUR_ROTATED_LINK4M_API_KEY
HCAPTCHA_SITEKEY=YOUR_HCAPTCHA_SITEKEY
HCAPTCHA_SECRET=YOUR_HCAPTCHA_SECRET
SIGNING_SECRET=GENERATE_A_PRIVATE_RANDOM_SECRET_AT_LEAST_32_BYTES
KEY_HOURS=24
UPSTASH_REDIS_REST_URL=SET_BY_UPSTASH_INTEGRATION
UPSTASH_REDIS_REST_TOKEN=SET_BY_UPSTASH_INTEGRATION

# Shared bridge secret: set the exact same random 64+ character value
# in this GET KEY project AND in the separate Admin Panel project.
# This value is server-only; never put it in HTML, Lua, or NEXT_PUBLIC_*.
KEY_ADMIN_API_TOKEN=GENERATE_A_PRIVATE_RANDOM_SECRET_AND_COPY_TO_BOTH_PROJECTS
